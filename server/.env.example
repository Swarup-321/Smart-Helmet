# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database mode: 'sqlite' or 'firebase'
DB_MODE=sqlite
SQLITE_DB_PATH=./data/mineguard.db

# Firebase Firestore Credentials (only needed if DB_MODE=firebase)
# Can be provided as a raw JSON string or path
FIREBASE_SERVICE_ACCOUNT=

# Security
DEVICE_API_KEY=mineguard_device_secret_key_2026
JWT_SECRET=mineguard_super_secure_jwt_secret_998877

# Initial Seed Admin Account
ADMIN_EMAIL=admin@mineguard.local
ADMIN_PASSWORD=Admin@123

# Performance & Rate Limits
CLIENT_ORIGIN=http://localhost:5173
HISTORY_INTERVAL_SEC=10
OFFLINE_TIMEOUT_SEC=30
